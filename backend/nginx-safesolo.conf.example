# ==============================================================================
# Cau hinh Nginx Reverse Proxy mau cho SafeSolo Backend (HTTPS + WSS Socket.IO)
# Copy vao: /etc/nginx/sites-available/safesolo.conf tren VPS Ubuntu
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name api.yourdomain.com; # Thay bang domain cua ban (vi du: api.safesolo.vn)

    # Chuyen huong tat ca HTTP sang HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.yourdomain.com; # Thay bang domain cua ban

    # Chung chi SSL (Tu dong tao boi Certbot Let's Encrypt)
    # ssl_certificate /etc/letsencrypt/live/api.yourdomain.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/api.yourdomain.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    client_max_body_size 25M; # Cho phep upload anh hien truong, bang chung Blackbox

    # 1. API Endpoint & Healthcheck
    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 2. Socket.IO (WebSockets cho Live Journey, Walkie-Talkie & Smartwatch Sync)
    location /socket.io/ {
        proxy_pass http://127.0.0.1:4000/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket timeouts dai lau cho Live Tracking
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
