# =================================================================
# SAFESOLO BACKEND - CẤU HÌNH BIẾN MÔI TRƯỜNG CLOUD PRODUCTION (RENDER / VPS)
# =================================================================

# Môi trường chạy
NODE_ENV=production
PORT=4000

# Kết nối MongoDB Atlas (Miễn phí 512MB M0 Cluster)
# Thay <username>, <password>, và <cluster-address> bằng thông tin từ MongoDB Atlas:
MONGODB_URI=mongodb+srv://safesolo_admin:<password>@cluster0.abcde.mongodb.net/Safesolo?retryWrites=true&w=majority
MONGODB_DB_NAME=Safesolo

# Bảo mật JWT
JWT_SECRET=safesolo_production_jwt_secret_key_super_secure_2026_random_string
JWT_EXPIRES_IN=30d

# Cho phép kết nối CORS (Dấu * hoặc tên miền Vercel / Cloudflare)
CORS_ORIGINS=*

# Cổng Telegram Bot khẩn cấp (Nhận cảnh báo SOS / Đo nhịp tim bất thường)
TELEGRAM_BOT_TOKEN=8895231809:AAGSSl99X2eYqXyR04xH1d_a8fF8Rk3-5bU

# Cấu hình Gửi Email Khẩn cấp (Gmail SMTP App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=safesolocompanyvn@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Redis (Không bắt buộc - nếu không có sẽ tự chạy native timer)
# REDIS_URL=rediss://default:<password>@<host>:6379
