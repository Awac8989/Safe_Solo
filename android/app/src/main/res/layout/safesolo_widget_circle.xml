<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_circle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="11dp"
    android:background="@drawable/widget_bg_circle">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_circle_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="SafeSolo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_circle_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SafeSolo Family Orbit"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_circle_user_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BS. CKII Lê Hoàng Nam"
                android:textColor="#94A3B8"
                android:textSize="9.5sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_circle_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ 4 AN TOÀN"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_member_card_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Center Section: 4 Members Grid (2x2) -->
    <LinearLayout
        android:id="@+id/widget_circle_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Row 1: Members 1 & 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_member_card_bg"
                android:padding="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_member_1_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👩 Mẹ Lan • Mẹ"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_member_1_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Ở nhà • 🔋 88%"
                    android:textColor="#34D399"
                    android:textSize="9sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_member_card_bg"
                android:padding="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_member_2_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👨 Ba Hùng • Ba"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_member_2_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Phòng ngủ • ⚡ 94%"
                    android:textColor="#34D399"
                    android:textSize="9sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Members 3 & 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_member_card_bg"
                android:padding="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_member_3_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👧 Linh • Bạn thân"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_member_3_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟡 Đi xe về • 🔋 38%"
                    android:textColor="#FBBF24"
                    android:textSize="9sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_member_card_bg"
                android:padding="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_member_4_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👦 Anh Hai • Anh"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_member_4_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Khu CNC • 🔋 75%"
                    android:textColor="#34D399"
                    android:textSize="9sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/widget_circle_btn_ping"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_blue"
            android:gravity="center"
            android:text="📡 Ping Gia Đình"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_circle_btn_share"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_checkin"
            android:gravity="center"
            android:text="📍 Chia Sẻ Vị Trí"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
