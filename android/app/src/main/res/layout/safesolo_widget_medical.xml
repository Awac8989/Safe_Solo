<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medical_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="11dp"
    android:background="@drawable/widget_bg_medical">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_medical_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="SafeSolo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_medical_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SafeSolo Medical I.C.E"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_medical_user_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BS. CKII Lê Hoàng Nam"
                android:textColor="#FCA5A5"
                android:textSize="9.5sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_medical_blood_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🩸 NHÓM O+"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_btn_sos"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Center Section: 2 Columns (Left: Medical Profile, Right: Emergency Contacts) -->
    <LinearLayout
        android:id="@+id/widget_medical_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Column 1: Medical Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_medical_card_bg"
            android:padding="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 DỊ ỨNG &amp; BỆNH NỀN"
                android:textColor="#F87171"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_medical_allergies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Dị ứng: Penicillin"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:paddingTop="2dp" />

            <TextView
                android:id="@+id/widget_medical_conditions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩺 Bệnh nền: Tăng HA"
                android:textColor="#E2E8F0"
                android:textSize="9.5sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_medical_vitals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🫁 98% SpO2 • ❤️ 78 BPM"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Column 2: Emergency Contact -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_medical_card_bg"
            android:padding="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ LIÊN HỆ CỨU HỘ"
                android:textColor="#F87171"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_medical_guardian_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Guardian 21A"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:paddingTop="2dp" />

            <TextView
                android:id="@+id/widget_medical_guardian_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞 0911002021"
                android:textColor="#34D399"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_medical_hospital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏥 BV: Chợ Rẫy"
                android:textColor="#E2E8F0"
                android:textSize="9sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/widget_medical_btn_guardian"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_blue"
            android:gravity="center"
            android:text="📞 Gọi Bảo Hộ"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_medical_btn_115"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_sos"
            android:gravity="center"
            android:text="🚑 CẤP CỨU 115"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
